{
  "name": "fieldcraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "export": "npm run build && node scripts/export-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser:install": "playwright install chromium",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "7.1.12"
  }
}
